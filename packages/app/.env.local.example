NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_KEY=<service role key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VOYAGE_API_KEY=<voyage api key>
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>
GMAIL_REDIRECT_URI=http://localhost:3000/api/connectors/gmail/callback
DRIVE_REDIRECT_URI=http://localhost:3000/api/connectors/drive/callback
# Optional — required for Gmail push notifications via Google Pub/Sub
GOOGLE_PUBSUB_TOPIC=projects/<project-id>/topics/<topic-name>
